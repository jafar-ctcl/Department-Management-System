<div class="container mt-4">
  <a href="/teacher" class="btn btn-outline-primary mb-3">🏠 Home</a>

  {{#if days.length}}
  <h2 class="text-center fw-bold text-dark">📅 Timetable</h2>

  <div class="table-responsive">
    <table class="table table-bordered table-striped">
      <thead class="table-dark text-center">
        <tr>
          <th>Day</th>
          {{#each times}}
          <th>{{this}}</th>
          {{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each days}}
        <tr>
          <td class="align-middle text-center fw-bold bg-light">{{this}}</td>
          {{#if (lookup ../timetable this)}}
          {{#each (lookup ../timetable this)}}
          <td class="text-left">
            {{#if subjects.length}}
            <ul class="mb-0">
              {{#each subjects}}
              <li><strong>{{subject}}</strong> ({{course}} - {{semester}})</li>
              {{/each}}
            </ul>
            {{else}}
            <ul class="mb-0"><li>No class</li></ul>
            {{/if}}
          </td>
          {{/each}}
          {{else}}
          <td colspan="{{../times.length}}" class="text-center fw-bold text-muted bg-light">
            No classes scheduled
          </td>
          {{/if}}
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{else}}
  <div class="alert alert-danger text-center mt-4">
    ❌ No timetable available for this teacher.
  </div>
  <div class="text-center">
    <a href="/teacher" class="btn btn-primary btn-sm mt-2">🔙 Go Back</a>
  </div>
  {{/if}}
</div>

<style>
  /* Table Styling */
  .table {
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  .table td,
  .table th {
    padding: 12px;
    font-size: 14px;
    border: 1px solid #ddd;
  }

  .table th {
    background-color: #343a40;
    color: white;
    font-size: 16px;
    font-weight: bold;
  }

  /* Responsive Table */
  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* Hover Effect */
  .table tbody tr:hover {
    background-color: #f1f1f1;
    transition: 0.3s;
  }

  /* No Classes Cell */
  .table td[colspan] {
    font-size: 16px;
    font-weight: 500;
    color: #666;
    text-align: center;
    background-color: #f9f9f9;
  }

  /* Heading & Button Styles */
  h2 {
    font-size: 24px;
    color: #343a40;
    margin-bottom: 20px;
  }

  .btn-outline-primary {
    font-weight: bold;
    border-radius: 8px;
  }

  /* List Styles */
  ul {
    list-style-type: none;
    padding-left: 0;
  }

  ul li {
    font-size: 14px;
  }

  /* Spacing */
  .mt-4 {
    margin-top: 2rem !important;
  }

  .mb-4 {
    margin-bottom: 2rem !important;
  }
</style>
